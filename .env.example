# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google Gemini
GEMINI_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
PUBLIC_BASE_URL=

# Providers
# Production refuses to start with MOCK_TELEPHONY=true, AI_PROVIDER=mock or
# ollama, or any unknown AI_PROVIDER. Leave these commented out in production.
# MOCK_TELEPHONY=true - use MockTelephony (logs + DB) instead of Twilio (dev only)
# AI_PROVIDER=gemini|ollama|mock - defaults to gemini when unset (ollama and mock are dev only)
# OLLAMA_URL=http://localhost:11434 - Ollama OpenAI-compatible endpoint
# OLLAMA_MODEL=llama3.2 - model name for Ollama
# MOCK_TELEPHONY=true
# AI_PROVIDER=gemini

# Time-waster (HIGH-risk calls only)
# TIME_WASTER_SECONDS=180 - max seconds the grandmother persona keeps a caller on the line.
# Default is 180. Values above 180 are clamped to 180; invalid or non-positive values fall back to 180.
TIME_WASTER_SECONDS=180

# Simulator and dev tools (keep both false in production)
# ENABLE_SIMULATOR=true allows the "Simulate a call" button and /api/simulate (demo household only).
ENABLE_SIMULATOR=false
# ENABLE_DEV_TOOLS=true allows /dev/phone and /api/dev/phone/* outside local development.
ENABLE_DEV_TOOLS=false
# Safe word the simulator uses for its scripted caller. Demo value only; never a real family safe word.
SIMULATOR_SAFE_WORD=

# Dashboard access (required; the dashboard stays closed if unset)
DASHBOARD_PASSCODE=
