# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google Gemini
GEMINI_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
PUBLIC_BASE_URL=

# Providers (dev/test)
# MOCK_TELEPHONY=true|false - use MockTelephony (logs + DB) instead of Twilio
# AI_PROVIDER=gemini|ollama|mock - AI backend selection
# OLLAMA_URL=http://localhost:11434 - Ollama OpenAI-compatible endpoint
# OLLAMA_MODEL=llama3.2 - model name for Ollama
MOCK_TELEPHONY=false
AI_PROVIDER=ollama

# Time-waster (HIGH-risk calls only)
# TIME_WASTER_SECONDS=180 - max seconds the grandmother persona keeps a caller on the line.
# Default is 180. Values above 180 are clamped to 180; invalid or non-positive values fall back to 180.
# TIME_WASTER_SECONDS=180

# Dashboard access (required; the dashboard stays closed if unset)
DASHBOARD_PASSCODE=
